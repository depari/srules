# GitHub API (규칙 제출용)
# GitHub Personal Access Token (repo 권한 필요)
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here
# 클라이언트 사이드에서 사용하려면 NEXT_PUBLIC_ 접두사 필요
NEXT_PUBLIC_GITHUB_TOKEN=your_github_token_here
NEXT_PUBLIC_GITHUB_OWNER=depari
NEXT_PUBLIC_GITHUB_REPO=srules

# Next.js 설정
# GitHub Pages 배포 시 저장소 이름 (예: /srules)
# 루트 도메인 사용 시 비워두기
NEXT_PUBLIC_BASE_PATH=

# 사이트 URL
NEXT_PUBLIC_SITE_URL=https://your-username.github.io/srules

# Google Analytics (Optional)
NEXT_PUBLIC_GA_ID=

# Telegram Notification (AntigravityNotiHelper_bot)
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
