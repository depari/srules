# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# AI Agent - 로컬 전용 (git 제외)
.cursor/memory/04_active_context.md
.cursor/memory/05_progress.md
.gemini/config.yaml

# AI Agent - 공유 가능 파일은 git 추적 (위 규칙 예외처리 불필요, 기본 추적)
# .cursor/rules/*.mdc           → 추적됨
# .cursor/memory/00~03_*.md    → 추적됨
# .gemini/styleguide.md        → 추적됨
# .gemini/guardrails.md        → 추적됨
# .ai/harness/*.md             → 추적됨
# .ai/guardrails/*.md          → 추적됨
# .github/copilot-instructions.md → 추적됨
# .github/prompts/*.md         → 추적됨
# AI_CONTEXT.md                → 추적됨
# scripts/notify.sh            → 추적됨
# scripts/update-ai-context.sh → 추적됨
